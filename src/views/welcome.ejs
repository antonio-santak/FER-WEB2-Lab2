<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome!</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div style="padding: 1rem;">
        <h1 id="welcome_title">Dobro došli!</h1>

        <p>Vratite se na početnu:</p>
        <a id="link" href="/">Početna</a>
    </div>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const userName = urlParams.get('name'); 

        const title = document.getElementById("welcome_title");
        const message = userName == null ? "Dobro došli!" : `Dobro došli, ${userName}!`;

    </script>
    <% if (vulnerable) { %>
        <script>
            title.innerHTML = message;
        </script>
    <% } else { %>
        <script>
            title.textContent = message;
        </script>
    <% } %>
</body>
</html>